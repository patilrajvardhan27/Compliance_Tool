INPUT ..
##def Ground[Name]
  UNDERGROUND-WALL
    CONSTRUCTION     = Name  $"Ground Floor"
    LOCATION         = BOTTOM
    ..
##enddef
##def Condition[Name]
  INTERIOR-WALL
    CONSTRUCTION     = Name  $"Conditioned Floor"
    INT-WALL-TYPE    = ADIABATIC
    LOCATION         = BOTTOM
    ..
##enddef
##def Uncondition[Name]
  EXTERIOR-WALL
    CONSTRUCTION     = Name  $"Unconditioned Floor"
    LOCATION         = BOTTOM
    ..
##enddef
